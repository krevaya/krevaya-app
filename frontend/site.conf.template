# Site config for the webapp container. Static files come from the build; /api, /ws,
# /media, /mcp and /admin go to the server container. The nginx image substitutes
# ${API_UPSTREAM} and ${WEB_LISTEN} when it starts.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# if something in front of us already terminated TLS, pass its scheme on instead of ours
map $http_x_forwarded_proto $edge_scheme {
    ''      $scheme;
    default $http_x_forwarded_proto;
}

upstream krevaya_server {
    server ${API_UPSTREAM};
    keepalive 16;
}

server {
    listen ${WEB_LISTEN} default_server;
    server_name _;
    root /usr/share/nginx/html;

    # a little above UPLOAD_LIMIT_MB so the API, not nginx, gives the friendly error
    client_max_body_size 60m;
    server_tokens off;

    # running another reverse proxy in front? Uncomment and list its network here, so
    # per-IP limits count visitors and not that proxy:
    # set_real_ip_from 172.16.0.0/12;
    # real_ip_header X-Forwarded-For;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml application/javascript application/json application/xml
               image/svg+xml application/wasm font/ttf font/otf;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    # overwrite rather than append; the server reads the first address only
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $edge_scheme;
    proxy_set_header Connection "";

    # vite puts a content hash in every file name here
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
    }

    location /api/ {
        proxy_pass http://krevaya_server;
        proxy_read_timeout 120s;
    }

    location /ws/ {
        proxy_pass http://krevaya_server;
        # nginx forgets server-level proxy headers once a location sets its own
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $edge_scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # editors stay connected for as long as the tab is open
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    location /media/ {
        proxy_pass http://krevaya_server;
        add_header Cache-Control "public, max-age=2592000";
        add_header X-Content-Type-Options nosniff always;
        # an uploaded SVG opened in its own tab gets no scripts and no network
        add_header Content-Security-Policy "sandbox; default-src 'none'; img-src data:; style-src 'unsafe-inline'" always;
    }

    location = /mcp {
        proxy_pass http://krevaya_server;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }

    location = /admin {
        proxy_pass http://krevaya_server;
    }

    location /admin/ {
        proxy_pass http://krevaya_server;
    }

    # everything else is a client-side route; index.html must always be fresh
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }
}
