# Krevaya settings. Copy this file to .env and adjust.
# Read from the repo root (or backend/.env); docker compose hands it to the server container too.
# true/false for switches. Rate limits are count/period, period = second, minute, hour or day.

# --- core ---
# signs sessions and links; make one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me
# verbose logs for local work only
DEBUG=false
# what visitors type in the address bar, without a slash at the end; links in emails,
# share links and sign-in callbacks start with this
SITE_URL=http://localhost:8460
# name in browser tabs, emails and /admin
SITE_NAME=Krevaya

# --- database ---
# empty means a sqlite file in backend/data; postgres looks like
# postgresql+asyncpg://user:password@host:5432/dbname (compose sets its own)
# DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# share rate-limit counters across processes, e.g. redis://localhost:6379/0
# (compose: add --profile cache, then use redis://cache:6379/0)
REDIS_URL=

# --- uploads ---
# folder for uploads and the sqlite file (compose mounts a volume at /data)
# DATA_DIR=./data
# path uploads are served under when kept on local disk
MEDIA_URL=/media
# biggest single upload, MB
UPLOAD_LIMIT_MB=50

# bucket storage (AWS S3, R2, B2, MinIO and friends); empty S3_BUCKET keeps files on disk
S3_BUCKET=
# empty on AWS; elsewhere something like https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# base URL browsers use to fetch objects, e.g. a CDN in front of the bucket
S3_PUBLIC_URL=

# --- accounts ---
# open registration; whoever signs up first on a new server is made admin
ALLOW_SIGNUP=true
# days before someone has to sign in again
SESSION_TTL_DAYS=14
# true once you serve over https
COOKIE_SECURE=false

# --- mail (empty SMTP_HOST prints messages to the log) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# upgrade the connection with STARTTLS
SMTP_TLS=true
EMAIL_FROM=Krevaya <noreply@localhost>

# --- Google accounts ---
# register <SITE_URL>/api/auth/google/callback as the redirect URI
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OpenID Connect (Keycloak, Authentik, Okta, Entra ID...) ---
# issuer URL = everything before /.well-known/openid-configuration
OIDC_ISSUER=
# register <SITE_URL>/api/auth/oidc/callback as the redirect URI
OIDC_CLIENT_ID=
# empty for a public client using PKCE
OIDC_CLIENT_SECRET=
# text on the sign-in button
OIDC_LABEL=Work account
OIDC_SCOPES=openid email profile

# --- stock search (the keys never leave the server) ---
UNSPLASH_KEY=
PEXELS_KEY=
FREESOUND_KEY=

# --- assistant API: MCP tools at /mcp, used with personal API tokens ---
ASSISTANT_API=false
# tool calls allowed per token
ASSISTANT_RATE=60/minute

# --- copies with new slot values ---
# rows accepted in one copies request
COPIES_PER_REQUEST=250
# let copies and "add from link" download https photos into the person's uploads
REMOTE_IMAGES=false

# --- headless export (POST /api/designs/<id>/export); needs Playwright and the frontend's /snapshot page ---
HEADLESS_EXPORT=false
# use this Chrome/Chromium instead of the one Playwright downloads
HEADLESS_BROWSER_PATH=
# base URL the server's browser loads the frontend from, when SITE_URL isn't reachable
# from the server itself (compose sets http://webapp:8460)
SNAPSHOT_URL=

# --- rate limits ---
# sign-in, registration and share-link password tries, per IP
RATE_LIMIT_LOGIN=10/minute
# uploads, per person
RATE_LIMIT_UPLOAD=60/minute
# headless exports, per person
RATE_LIMIT_EXPORT=30/minute
# copies made through the API, MCP or the spreadsheet dialog, per person
RATE_LIMIT_COPIES=100/minute
# photos fetched from links while making copies, per person
RATE_LIMIT_REMOTE_IMAGES=200/minute

# --- used by docker compose only ---
# password for the postgres container
POSTGRES_PASSWORD=change-me-too
# host port the webapp is reachable on
WEB_PORT=8460
